<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RippersCasino.Client</AssemblyName>
    <RootNamespace>RippersCasino.Client</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoWarn>$(NoWarn);0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(SptRoot)\BepInEx\core\0Harmony.dll" Private="false" />
